{
  "extends": "./.tsconfig.json",
  "compilerOptions": {
    "allowUnreachableCode": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["bun", "node"],

    "noEmit": true,

    "checkJs": true
  }
}
