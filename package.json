{
  "name": "metalint",
  "version": "0.22.1",
  "description": "One linter to rule them all.",
  "keywords": [
    "checker",
    "lint",
    "metalint",
    "quality",
    "static-analysis"
  ],
  "homepage": "https://github.com/regseb/metalint#readme",
  "bugs": {
    "url": "https://github.com/regseb/metalint/issues",
    "email": "regseb@gmail.com"
  },
  "license": "MIT",
  "author": "Sébastien Règne <regseb@gmail.com> (https://github.com/regseb)",
  "funding": [
    "https://buymeacoffee.com/regseb",
    "https://www.paypal.me/sebastienregne"
  ],
  "files": [
    "./src/",
    "./types/"
  ],
  "exports": {
    ".": {
      "types": "./types/core/index.d.ts",
      "default": "./src/core/index.js"
    },
    "./api/formatter": {
      "types": "./types/core/formatter/formatter.d.ts",
      "default": "./src/core/formatter/formatter.js"
    },
    "./api/wrapper": {
      "types": "./types/core/wrapper/wrapper.d.ts",
      "default": "./src/core/wrapper/wrapper.js"
    },
    "./types": {
      "types": "./types/core/types.d.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/core/index.js",
  "types": "./types/core/index.d.ts",
  "bin": {
    "metalint": "src/bin/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regseb/metalint.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "tsc --project .tsconfig_types.json",
    "lint": "node src/bin/index.js",
    "lint:fix": "node src/bin/index.js --fix",
    "lint:types": "tsc --project .tsconfig_lint.json",
    "lint:npm": "npm pack --dry-run --quiet",
    "lint:jsr": "npx jsr publish --dry-run",
    "test": "npm run test:coverage",
    "test:unit": "npm run test:unit:node",
    "test:unit:node": "node --test \"test/unit/**/*.test.js\"",
    "test:unit:bun": "bun test test/unit/",
    "test:unit:deno": "deno test --allow-env --allow-net --allow-read --allow-run --allow-sys --allow-write --no-check --unsafe-proto test/unit/",
    "test:fuzz": "node --test \"test/fuzz/**/*.test.js\"",
    "test:coverage": "stryker run",
    "jsdocs": "typedoc --tsconfig .tsconfig_jsdocs.json",
    "clean": "node .script/clean.js"
  },
  "devDependencies": {
    "@biomejs/js-api": "6.0.0",
    "@biomejs/wasm-nodejs": "2.5.8",
    "@coffeelint/cli": "5.2.11",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@mapbox/jsonlint-lines-primitives": "2.0.3",
    "@prantlf/jsonlint": "17.0.1",
    "@prettier/plugin-xml": "3.4.2",
    "@secretlint/secretlint-rule-github": "13.0.4",
    "@secretlint/secretlint-rule-npm": "13.0.4",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/tap-runner": "10.0.0",
    "@types/bun": "1.3.14",
    "@types/eslint-plugin-security": "3.0.1",
    "@types/htmlhint": "1.1.5",
    "@types/js-yaml": "4.0.9",
    "@types/jshint": "2.12.4",
    "@types/node": "26.2.0",
    "@typescript-eslint/utils": "8.67.0",
    "addons-linter": "10.10.0",
    "ajv": "8.20.0",
    "depcheck": "1.4.7",
    "doiuse": "6.0.6",
    "eslint": "10.8.1",
    "eslint-plugin-array-func": "5.1.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "64.2.0",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.2.0",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-unicorn": "73.0.0",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "htmlhint": "1.9.0",
    "htmllint": "0.8.0",
    "jshint": "2.13.6",
    "jsonlint-mod": "1.7.6",
    "jsr": "0.14.3",
    "jszip": "3.10.1",
    "markdownlint": "0.41.1",
    "markuplint": "4.18.3",
    "npm-check-updates": "23.0.2",
    "npm-package-json-lint": "11.0.0",
    "prettier": "3.9.6",
    "publint": "0.3.23",
    "purgecss": "8.0.0",
    "secretlint": "13.0.4",
    "sort-package-json": "4.0.0",
    "standard": "17.1.2",
    "stylelint": "17.14.1",
    "svglint": "4.2.1",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "yaml-lint": "1.7.0"
  },
